# ============================================================
# Jira Repo Automation — Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Environment variables always take precedence over values
# supplied via a config file.
# ============================================================

# ------------------------------------------------------------
# Jira credentials (all three are REQUIRED)
# ------------------------------------------------------------

# Base URL of your Jira instance, e.g. https://yourorg.atlassian.net
JIRA_BASE_URL=https://treeleafworm.atlassian.net

# Jira username / email address associated with the API token
JIRA_USERNAME=treeleafworm@gmail.com

# Jira API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=

# ------------------------------------------------------------
# Git credentials (at least ONE of the following is REQUIRED)
# ------------------------------------------------------------

# Absolute path to the SSH private key used to authenticate with the Git remote.
# Leave blank if using a Personal Access Token instead.
GIT_SSH_KEY_PATH=

# Personal Access Token (PAT) for HTTPS-based Git authentication.
# Leave blank if using an SSH key instead.
GIT_PAT=

# ------------------------------------------------------------
# Optional tool behaviour overrides
# ------------------------------------------------------------

# Base directory where repositories are cloned.
# Defaults to D:\Others\MainProjs\pullnupshpulls if not set.
# WORKING_DIR_BASE=D:\Others\MainProjs\pullnupshpulls

# Log output format: "text" (default) or "json"
# LOG_FORMAT=text

# Set to "true" to enable DEBUG-level log output.
# VERBOSE=false
